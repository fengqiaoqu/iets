 /// Best-effort position of an IR node, for error messages.
+pub fn ir_tag(ir: &Ir) -> u8 {
+    match ir {
+        Ir::Apply { .. } => 1,
+        Ir::Select(_) | Ir::Select1 { .. } | Ir::SelectCount(_) => 2,
+        Ir::Attrs(_) => 3,
+        Ir::List(_) => 4,
+        Ir::Let(_) => 5,
+        Ir::If { .. } => 6,
+        Ir::Concat { .. } => 7,
+        Ir::With { .. } => 8,
+        Ir::Update(..) => 9,
+        Ir::WithVar { .. } => 10,
+        Ir::ConcatLists(..) => 11,
+        Ir::Local { .. } => 12,
+        _ => 0,
+    }
+}
