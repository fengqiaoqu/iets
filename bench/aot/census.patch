+//! Scratch census for the precompiled-IR exploration; not for landing.
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::{Mutex, OnceLock};
+
+pub static WITH_EVALS: AtomicU64 = AtomicU64::new(0);
+pub static WITH_HIT_AT: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+pub static WITH_MISS_PROBES: AtomicU64 = AtomicU64::new(0);
+pub static WITH_GLOBAL: AtomicU64 = AtomicU64::new(0);
+pub static WITH_CHAIN_LEN: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+pub static EAGER_OK: AtomicU64 = AtomicU64::new(0);
+pub static EAGER_ERR: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Default)]
+pub struct Site {
+    pub created: u64,
+    pub forced: u64,
+    pub tag: u8,
+    pub pos: u64,
+    pub elig: bool,
+}
+
+thread_local! { pub static ELIG: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+
+pub static SITES: Mutex<Option<HashMap<usize, Site>>> = Mutex::new(None);
+
+pub fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var_os("IETS_AOT_STATS").is_some();
+        if on {
+            *SITES.lock().unwrap() = Some(HashMap::new());
+            unsafe { libc::atexit(dump) };
+        }
+        on
+    })
+}
+
+/// Sites (pos, tag) to evaluate eagerly, read from `IETS_AOT_EAGER`.
+pub fn eager() -> Option<&'static std::collections::HashSet<(u64, u8)>> {
+    static SET: OnceLock<Option<std::collections::HashSet<(u64, u8)>>> = OnceLock::new();
+    SET.get_or_init(|| {
+        let p = std::env::var_os("IETS_AOT_EAGER")?;
+        let s = std::fs::read_to_string(p).ok()?;
+        Some(
+            s.lines()
+                .filter_map(|l| {
+                    let mut it = l.split_whitespace();
+                    Some((it.next()?.parse().ok()?, it.next()?.parse().ok()?))
+                })
+                .collect(),
+        )
+    })
+    .as_ref()
+}
+
+pub fn created(ir: usize, tag: u8, pos: u64) {
+    let mut g = SITES.lock().unwrap();
+    let s = g.as_mut().unwrap().entry(ir).or_default();
+    s.created += 1;
+    s.tag = tag;
+    s.pos = pos;
+    s.elig |= ELIG.with(|e| e.get());
+}
+
+pub fn forced(ir: usize) {
+    let mut g = SITES.lock().unwrap();
+    if let Some(s) = g.as_mut().unwrap().get_mut(&ir) {
+        s.forced += 1;
+    }
+}
+
+extern "C" fn dump() {
+    let l = |a: &AtomicU64| a.load(Relaxed);
+    eprintln!(
+        "AOT with evals={} hit_at={:?} miss_probes={} global={} chain_len={:?}",
+        l(&WITH_EVALS),
+        WITH_HIT_AT.iter().map(l).collect::<Vec<_>>(),
+        l(&WITH_MISS_PROBES),
+        l(&WITH_GLOBAL),
+        WITH_CHAIN_LEN.iter().map(l).collect::<Vec<_>>(),
+    );
+    dump_dup();
+    eprintln!("AOT eager ok={} err={}", l(&EAGER_OK), l(&EAGER_ERR));
+    if let Some(p) = std::env::var_os("IETS_AOT_ERR_TO")
+        && let Some(e) = ERR_SITES.lock().unwrap().as_ref()
+    {
+        let out: String = e.iter().map(|(a, b)| format!("{a} {b}\n")).collect();
+        let _ = std::fs::write(p, out);
+    }
+    let g = SITES.lock().unwrap();
+    let Some(m) = g.as_ref() else { return };
+    let (mut tc, mut tf, mut always_c, mut always_s, mut never_c, mut ge99_c) = (0, 0, 0, 0, 0, 0);
+    let (mut ec, mut ea) = (0u64, 0u64);
+    let mut by_tag: HashMap<u8, (u64, u64, u64)> = HashMap::new();
+    for s in m.values() {
+        tc += s.created;
+        tf += s.forced;
+        let e = by_tag.entry(s.tag).or_default();
+        e.0 += s.created;
+        e.1 += s.forced;
+        if s.forced == s.created {
+            always_c += s.created;
+            always_s += 1;
+            e.2 += s.created;
+        }
+        if s.elig {
+            ec += s.created;
+            if s.forced == s.created {
+                ea += s.created;
+            }
+        }
+        if s.forced == 0 {
+            never_c += s.created;
+        }
+        if s.forced * 100 >= s.created * 99 {
+            ge99_c += s.created;
+        }
+    }
+    eprintln!(
+        "AOT thunks sites={} created={} forced={} always_forced_thunks={} always_forced_sites={} never_forced_thunks={} ge99_thunks={}",
+        m.len(), tc, tf, always_c, always_s, never_c, ge99_c
+    );
+    eprintln!("AOT eligible created={ec} always_forced={ea}");
+    let mut tags: Vec<_> = by_tag.into_iter().collect();
+    tags.sort_by_key(|t| std::cmp::Reverse(t.1.0));
+    for (t, (c, f, a)) in tags {
+        eprintln!("AOT tag {t} created={c} forced={f} always={a}");
+    }
+    if let Some(p) = std::env::var_os("IETS_AOT_SITES_TO") {
+        let mut out = String::new();
+        for s in m.values() {
+            if s.elig && s.created > 0 && s.forced == s.created {
+                out.push_str(&format!("{} {}\n", s.pos, s.tag));
+            }
+        }
+        let _ = std::fs::write(p, out);
+    }
+}
+
+thread_local! {
+    pub static MEMO: std::cell::RefCell<HashMap<usize, bool>> = std::cell::RefCell::new(HashMap::new());
+}
+
+pub fn path_hash(p: &[u8]) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    p.hash(&mut h);
+    h.finish() & 0xffff_ffff
+}
+
+pub static ERR_SITES: Mutex<Option<std::collections::HashSet<(u64, u8)>>> = Mutex::new(None);
+
+pub fn err_site(k: (u64, u8)) {
+    ERR_SITES.lock().unwrap().get_or_insert_with(Default::default).insert(k);
+}
+
+use crate::compile::ir::{AttrElemIr, Ir, IrRef, ParamIr};
+use std::hash::{Hash, Hasher};
+
+#[derive(Default)]
+pub struct Dup {
+    nodes: u64,
+    lambdas: u64,
+    distinct: std::collections::HashSet<u64>,
+    seen_lambdas: std::collections::HashSet<u64>,
+    lambda_dup: u64,
+    lambda_dup_nodes: u64,
+    closed_dup: u64,
+}
+
+pub static DUP: Mutex<Option<Dup>> = Mutex::new(None);
+
+type Memo = HashMap<usize, (u64, u64)>;
+
+fn h_of(parts: &[u64]) -> u64 {
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    parts.hash(&mut h);
+    h.finish()
+}
+
+/// Structural hash and node count of `ir`, positions and names ignored.
+fn shape(ir: IrRef, m: &mut Memo, d: &mut Dup) -> (u64, u64) {
+    let k = ir as *const Ir as usize;
+    if let Some(&r) = m.get(&k) {
+        return r;
+    }
+    let mut p: Vec<u64> = Vec::new();
+    let mut n = 1u64;
+    let mut kid = |e: IrRef, p: &mut Vec<u64>, n: &mut u64, m: &mut Memo, d: &mut Dup| {
+        let (h, c) = shape(e, m, d);
+        p.push(h);
+        *n += c;
+    };
+    let sym = |s: crate::syntax::symbol::Sym| {
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        s.hash(&mut h);
+        h.finish()
+    };
+    macro_rules! elems {
+        ($path:expr) => {
+            for e in $path.iter() {
+                match e {
+                    AttrElemIr::Static(s) => p.push(sym(*s)),
+                    AttrElemIr::Dynamic(e) => kid(e, &mut p, &mut n, m, d),
+                }
+            }
+        };
+    }
+    match ir {
+        Ir::Const(w) => p.extend([1, w.bits()]),
+        Ir::Local { depth, idx } => p.extend([2, u64::from(*depth), u64::from(*idx)]),
+        Ir::WithVar { sym: s, withs, .. } => {
+            p.extend([3, sym(*s)]);
+            p.extend(withs.iter().map(|&x| u64::from(x)));
+        }
+        Ir::CurPos(_) => p.push(4),
+        Ir::Concat { force_string, parts, .. } => {
+            p.extend([5, u64::from(*force_string)]);
+            for e in parts.iter() {
+                kid(e, &mut p, &mut n, m, d);
+            }
+        }
+        Ir::SearchPath { name, .. } => {
+            p.push(6);
+            kid(name, &mut p, &mut n, m, d);
+        }
+        Ir::Select(s) | Ir::SelectCount(s) => {
+            p.push(if matches!(ir, Ir::Select(_)) { 7 } else { 8 });
+            kid(s.subject, &mut p, &mut n, m, d);
+            elems!(s.path);
+            if let Some(e) = s.default {
+                kid(e, &mut p, &mut n, m, d);
+            }
+        }
+        Ir::Select1 { subject, sym: s, default, .. } => {
+            p.extend([9, sym(*s)]);
+            kid(subject, &mut p, &mut n, m, d);
+            if let Some(e) = default {
+                kid(e, &mut p, &mut n, m, d);
+            }
+        }
+        Ir::HasAttr { subject, path } => {
+            p.push(10);
+            kid(subject, &mut p, &mut n, m, d);
+            elems!(path);
+        }
+        Ir::Attrs(a) => {
+            p.extend([11, u64::from(a.rec), a.overrides.map_or(u64::MAX, u64::from)]);
+            for b in a.binds.iter() {
+                p.extend([sym(b.sym), b.scope as u64]);
+                kid(b.value, &mut p, &mut n, m, d);
+            }
+            for e in a.from.iter() {
+                kid(e, &mut p, &mut n, m, d);
+            }
+            for db in a.dynamic.iter() {
+                kid(db.name, &mut p, &mut n, m, d);
+                kid(db.value, &mut p, &mut n, m, d);
+            }
+        }
+        Ir::List(items) => {
+            p.push(12);
+            for e in items.iter() {
+                kid(e, &mut p, &mut n, m, d);
+            }
+        }
+        Ir::Lambda(l) => {
+            p.push(13);
+            match &l.param {
+                ParamIr::Ident => p.push(0),
+                ParamIr::Formals { has_bind, formals, ellipsis } => {
+                    p.extend([1, u64::from(*has_bind), u64::from(*ellipsis)]);
+                    for f in formals.iter() {
+                        p.push(sym(f.sym));
+                        match f.default {
+                            Some(e) => kid(e, &mut p, &mut n, m, d),
+                            None => p.push(0),
+                        }
+                    }
+                }
+            }
+            kid(l.body, &mut p, &mut n, m, d);
+        }
+        Ir::Apply { func, args, .. } => {
+            p.push(14);
+            kid(func, &mut p, &mut n, m, d);
+            for e in args.iter() {
+                kid(e, &mut p, &mut n, m, d);
+            }
+        }
+        Ir::Let(l) => {
+            p.push(15);
+            for b in l.binds.iter() {
+                p.extend([sym(b.sym), b.scope as u64]);
+                kid(b.value, &mut p, &mut n, m, d);
+            }
+            for e in l.from.iter() {
+                kid(e, &mut p, &mut n, m, d);
+            }
+            kid(l.body, &mut p, &mut n, m, d);
+        }
+        Ir::With { scope, body, .. } => {
+            p.push(16);
+            kid(scope, &mut p, &mut n, m, d);
+            kid(body, &mut p, &mut n, m, d);
+        }
+        Ir::If { cond, then, else_, .. } => {
+            p.push(17);
+            for e in [*cond, *then, *else_] {
+                kid(e, &mut p, &mut n, m, d);
+            }
+        }
+        Ir::Assert { cond, body, .. } => {
+            p.push(18);
+            kid(cond, &mut p, &mut n, m, d);
+            kid(body, &mut p, &mut n, m, d);
+        }
+        Ir::Not(e, _) | Ir::Neg(e, _) => {
+            p.push(if matches!(ir, Ir::Not(..)) { 19 } else { 20 });
+            kid(e, &mut p, &mut n, m, d);
+        }
+        Ir::Eq(a, b, _) | Ir::Ne(a, b, _) | Ir::Lt(a, b, _) | Ir::Gt(a, b, _) | Ir::Le(a, b, _)
+        | Ir::Ge(a, b, _) | Ir::And(a, b, _) | Ir::Or(a, b, _) | Ir::Impl(a, b, _)
+        | Ir::Update(a, b, _) | Ir::ConcatLists(a, b, _) | Ir::Sub(a, b, _) | Ir::Mul(a, b, _)
+        | Ir::Div(a, b, _) => {
+            p.push(std::mem::discriminant(ir).hash_code());
+            kid(a, &mut p, &mut n, m, d);
+            kid(b, &mut p, &mut n, m, d);
+        }
+    }
+    let h = h_of(&p);
+    d.nodes += 0;
+    m.insert(k, (h, n));
+    (h, n)
+}
+
+trait HashCode {
+    fn hash_code(&self) -> u64;
+}
+impl<T> HashCode for std::mem::Discriminant<T> {
+    fn hash_code(&self) -> u64 {
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        self.hash(&mut h);
+        h.finish()
+    }
+}
+
+/// Top-down: count every node, and every lambda whose shape an earlier
+/// lambda already had; the body of such a lambda is not walked again.
+fn walk(ir: IrRef, m: &Memo, d: &mut Dup, visited: &mut std::collections::HashSet<usize>) {
+    let k = ir as *const Ir as usize;
+    if !visited.insert(k) {
+        return;
+    }
+    let (h, n) = m[&k];
+    d.nodes += 1;
+    d.distinct.insert(h);
+    if let Ir::Lambda(l) = ir {
+        d.lambdas += 1;
+        if !d.seen_lambdas.insert(h) {
+            d.lambda_dup += 1;
+            d.lambda_dup_nodes += n;
+            d.closed_dup += u64::from(l.closed);
+            count_rest(ir, m, d, visited);
+            return;
+        }
+    }
+    children(ir, &mut |c| walk(c, m, d, visited));
+}
+
+fn count_rest(ir: IrRef, m: &Memo, d: &mut Dup, visited: &mut std::collections::HashSet<usize>) {
+    children(ir, &mut |c| {
+        let k = c as *const Ir as usize;
+        if visited.insert(k) {
+            d.nodes += 1;
+            d.distinct.insert(m[&k].0);
+            count_rest(c, m, d, visited);
+        }
+    });
+}
+
+fn children(ir: IrRef, f: &mut dyn FnMut(IrRef)) {
+    let el = |path: &[AttrElemIr], f: &mut dyn FnMut(IrRef)| {
+        for e in path {
+            if let AttrElemIr::Dynamic(e) = e {
+                f(e);
+            }
+        }
+    };
+    match ir {
+        Ir::Const(_) | Ir::Local { .. } | Ir::WithVar { .. } | Ir::CurPos(_) => {}
+        Ir::Concat { parts, .. } => parts.iter().for_each(|e| f(e)),
+        Ir::SearchPath { name, .. } => f(name),
+        Ir::Select(s) | Ir::SelectCount(s) => {
+            f(s.subject);
+            el(s.path, f);
+            if let Some(e) = s.default {
+                f(e);
+            }
+        }
+        Ir::Select1 { subject, default, .. } => {
+            f(subject);
+            if let Some(e) = default {
+                f(e);
+            }
+        }
+        Ir::HasAttr { subject, path } => {
+            f(subject);
+            el(path, f);
+        }
+        Ir::Attrs(a) => {
+            a.binds.iter().for_each(|b| f(b.value));
+            a.from.iter().for_each(|e| f(e));
+            a.dynamic.iter().for_each(|b| {
+                f(b.name);
+                f(b.value);
+            });
+        }
+        Ir::List(items) => items.iter().for_each(|e| f(e)),
+        Ir::Lambda(l) => {
+            if let ParamIr::Formals { formals, .. } = &l.param {
+                formals.iter().filter_map(|x| x.default).for_each(|e| f(e));
+            }
+            f(l.body);
+        }
+        Ir::Apply { func, args, .. } => {
+            f(func);
+            args.iter().for_each(|e| f(e));
+        }
+        Ir::Let(l) => {
+            l.binds.iter().for_each(|b| f(b.value));
+            l.from.iter().for_each(|e| f(e));
+            f(l.body);
+        }
+        Ir::With { scope, body, .. } => {
+            f(scope);
+            f(body);
+        }
+        Ir::If { cond, then, else_, .. } => {
+            f(cond);
+            f(then);
+            f(else_);
+        }
+        Ir::Assert { cond, body, .. } => {
+            f(cond);
+            f(body);
+        }
+        Ir::Not(e, _) | Ir::Neg(e, _) => f(e),
+        Ir::Eq(a, b, _) | Ir::Ne(a, b, _) | Ir::Lt(a, b, _) | Ir::Gt(a, b, _) | Ir::Le(a, b, _)
+        | Ir::Ge(a, b, _) | Ir::And(a, b, _) | Ir::Or(a, b, _) | Ir::Impl(a, b, _)
+        | Ir::Update(a, b, _) | Ir::ConcatLists(a, b, _) | Ir::Sub(a, b, _) | Ir::Mul(a, b, _)
+        | Ir::Div(a, b, _) => {
+            f(a);
+            f(b);
+        }
+    }
+}
+
+pub fn note_file(root: IrRef) {
+    let mut g = DUP.lock().unwrap();
+    let d = g.get_or_insert_with(Default::default);
+    let mut m = Memo::new();
+    shape(root, &mut m, d);
+    walk(root, &m, d, &mut Default::default());
+}
+
+pub fn dump_dup() {
+    let g = DUP.lock().unwrap();
+    let Some(d) = g.as_ref() else { return };
+    eprintln!(
+        "AOT dup nodes={} distinct_shapes={} lambdas={} lambda_dup={} lambda_dup_nodes={} closed_dup={}",
+        d.nodes,
+        d.distinct.len(),
+        d.lambdas,
+        d.lambda_dup,
+        d.lambda_dup_nodes,
+        d.closed_dup
+    );
+}
