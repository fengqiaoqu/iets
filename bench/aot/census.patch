+    pub fn maybe_thunk_e(&mut self, env: &'static EnvObj, ir: IrRef) -> Word {
+        if let Some(set) = crate::aotstats::eager()
+            && !matches!(ir, Ir::Const(_) | Ir::Local { .. } | Ir::Lambda(_))
+            && crate::aotstats::MEMO.with(|m| {
+                let k = ir as *const Ir as usize;
+                if let Some(&b) = m.borrow().get(&k) {
+                    return b;
+                }
