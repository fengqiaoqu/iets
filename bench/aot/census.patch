@@ -0,0 +1,155 @@
+//! Scratch census for the precompiled-IR exploration; not for landing.
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::{Mutex, OnceLock};
+
+pub static WITH_EVALS: AtomicU64 = AtomicU64::new(0);
+pub static WITH_HIT_AT: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+pub static WITH_MISS_PROBES: AtomicU64 = AtomicU64::new(0);
+pub static WITH_GLOBAL: AtomicU64 = AtomicU64::new(0);
+pub static WITH_CHAIN_LEN: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+pub static EAGER_OK: AtomicU64 = AtomicU64::new(0);
+pub static EAGER_ERR: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Default)]
+pub struct Site {
+    pub created: u64,
+    pub forced: u64,
+    pub tag: u8,
+    pub pos: u64,
+    pub elig: bool,
+}
+
+thread_local! { pub static ELIG: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+
+pub static SITES: Mutex<Option<HashMap<usize, Site>>> = Mutex::new(None);
+
+pub fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var_os("IETS_AOT_STATS").is_some();
+        if on {
+            *SITES.lock().unwrap() = Some(HashMap::new());
+            unsafe { libc::atexit(dump) };
+        }
+        on
+    })
+}
+
+/// Sites (pos, tag) to evaluate eagerly, read from `IETS_AOT_EAGER`.
+pub fn eager() -> Option<&'static std::collections::HashSet<(u64, u8)>> {
+    static SET: OnceLock<Option<std::collections::HashSet<(u64, u8)>>> = OnceLock::new();
+    SET.get_or_init(|| {
+        let p = std::env::var_os("IETS_AOT_EAGER")?;
+        let s = std::fs::read_to_string(p).ok()?;
+        Some(
+            s.lines()
+                .filter_map(|l| {
+                    let mut it = l.split_whitespace();
+                    Some((it.next()?.parse().ok()?, it.next()?.parse().ok()?))
+                })
+                .collect(),
+        )
+    })
+    .as_ref()
+}
+
+pub fn created(ir: usize, tag: u8, pos: u64) {
+    let mut g = SITES.lock().unwrap();
+    let s = g.as_mut().unwrap().entry(ir).or_default();
+    s.created += 1;
+    s.tag = tag;
+    s.pos = pos;
+    s.elig |= ELIG.with(|e| e.get());
+}
+
+pub fn forced(ir: usize) {
+    let mut g = SITES.lock().unwrap();
+    if let Some(s) = g.as_mut().unwrap().get_mut(&ir) {
+        s.forced += 1;
+    }
+}
+
+extern "C" fn dump() {
+    let l = |a: &AtomicU64| a.load(Relaxed);
+    eprintln!(
+        "AOT with evals={} hit_at={:?} miss_probes={} global={} chain_len={:?}",
+        l(&WITH_EVALS),
+        WITH_HIT_AT.iter().map(l).collect::<Vec<_>>(),
+        l(&WITH_MISS_PROBES),
+        l(&WITH_GLOBAL),
+        WITH_CHAIN_LEN.iter().map(l).collect::<Vec<_>>(),
+    );
+    eprintln!("AOT eager ok={} err={}", l(&EAGER_OK), l(&EAGER_ERR));
+    if let Some(p) = std::env::var_os("IETS_AOT_ERR_TO")
+        && let Some(e) = ERR_SITES.lock().unwrap().as_ref()
+    {
+        let out: String = e.iter().map(|(a, b)| format!("{a} {b}\n")).collect();
+        let _ = std::fs::write(p, out);
+    }
+    let g = SITES.lock().unwrap();
+    let Some(m) = g.as_ref() else { return };
+    let (mut tc, mut tf, mut always_c, mut always_s, mut never_c, mut ge99_c) = (0, 0, 0, 0, 0, 0);
+    let (mut ec, mut ea) = (0u64, 0u64);
+    let mut by_tag: HashMap<u8, (u64, u64, u64)> = HashMap::new();
+    for s in m.values() {
+        tc += s.created;
+        tf += s.forced;
+        let e = by_tag.entry(s.tag).or_default();
+        e.0 += s.created;
+        e.1 += s.forced;
+        if s.forced == s.created {
+            always_c += s.created;
+            always_s += 1;
+            e.2 += s.created;
+        }
+        if s.elig {
+            ec += s.created;
+            if s.forced == s.created {
+                ea += s.created;
+            }
+        }
+        if s.forced == 0 {
+            never_c += s.created;
+        }
+        if s.forced * 100 >= s.created * 99 {
+            ge99_c += s.created;
+        }
+    }
+    eprintln!(
+        "AOT thunks sites={} created={} forced={} always_forced_thunks={} always_forced_sites={} never_forced_thunks={} ge99_thunks={}",
+        m.len(), tc, tf, always_c, always_s, never_c, ge99_c
+    );
+    eprintln!("AOT eligible created={ec} always_forced={ea}");
+    let mut tags: Vec<_> = by_tag.into_iter().collect();
+    tags.sort_by_key(|t| std::cmp::Reverse(t.1.0));
+    for (t, (c, f, a)) in tags {
+        eprintln!("AOT tag {t} created={c} forced={f} always={a}");
+    }
+    if let Some(p) = std::env::var_os("IETS_AOT_SITES_TO") {
+        let mut out = String::new();
+        for s in m.values() {
+            if s.elig && s.created > 0 && s.forced == s.created {
+                out.push_str(&format!("{} {}\n", s.pos, s.tag));
+            }
+        }
+        let _ = std::fs::write(p, out);
+    }
+}
+
+thread_local! {
+    pub static MEMO: std::cell::RefCell<HashMap<usize, bool>> = std::cell::RefCell::new(HashMap::new());
+}
+
+pub fn path_hash(p: &[u8]) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    p.hash(&mut h);
+    h.finish() & 0xffff_ffff
+}
+
+pub static ERR_SITES: Mutex<Option<std::collections::HashSet<(u64, u8)>>> = Mutex::new(None);
+
+pub fn err_site(k: (u64, u8)) {
+    ERR_SITES.lock().unwrap().get_or_insert_with(Default::default).insert(k);
+}
