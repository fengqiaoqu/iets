+        }
+        if crate::aotstats::on() {
+            crate::aotstats::ELIG.with(|e| e.set(true));
+            let w = self.maybe_thunk(env, ir);
+            crate::aotstats::ELIG.with(|e| e.set(false));
+            return w;
+        }
+        self.maybe_thunk(env, ir)
+    }
